[gd_scene format=3]

[ext_resource type="Script" path="res://tests/visual/fx_showcase.gd" id="1_showcase"]
[ext_resource type="Script" path="res://combat/battle_background.gd" id="2_background"]
[ext_resource type="Script" path="res://fx/battle_camera.gd" id="3_camera"]
[ext_resource type="Script" path="res://fx/battle_fx.gd" id="4_fx"]

[node name="FxShowcase" type="Node2D"]
